{
  "name": "guc-authentication-access",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "start": "node --env-file-if-exists=.env server.js",
    "dev": "node --env-file-if-exists=.env --watch server.js",
    "test": "node --test tests/*.test.js",
    "seed": "node --env-file-if-exists=.env seed/seedStudents.js",
    "mongo": "node scripts/devMongo.js",
    "seed:catalogue": "node --env-file-if-exists=.env seed/seedCatalogue.js",
    "test:catalogue": "node --test tests/catalogue.unit.test.js tests/catalogue.api.test.js",
    "smoke:catalogue": "node --env-file-if-exists=.env scripts/smokeCatalogue.js",
    "setup:env": "node scripts/makeEnv.js"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "express": "^5.2.1",
    "express-rate-limit": "^8.0.0",
    "helmet": "^8.0.0",
    "jsonwebtoken": "^9.0.3",
    "mongoose": "^9.11.1",
    "nodemailer": "^10.0.16"
  },
  "devDependencies": {
    "mingo": "^7.2.4",
    "mongodb-memory-server": "^11.3.0",
    "supertest": "^7.3.1"
  },
  "allowScripts": {
    "mongodb-memory-server@11.3.0": true
  }
}